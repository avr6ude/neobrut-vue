{
  "name": "@neobrut-vue/core",
  "version": "0.3.0",
  "description": "Colorful and accessible neo-brutalist components for Vue 3.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avr6ude/neobrut-vue.git"
  },
  "homepage": "https://github.com/avr6ude/neobrut-vue#readme",
  "bugs": {
    "url": "https://github.com/avr6ude/neobrut-vue/issues"
  },
  "type": "module",
  "main": "./dist/neobrut-vue.js",
  "module": "./dist/neobrut-vue.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/neobrut-vue.css",
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/neobrut-vue.js",
      "default": "./dist/neobrut-vue.js"
    },
    "./style.css": "./dist/neobrut-vue.css",
    "./package.json": "./package.json"
  },
  "keywords": ["vue", "vue3", "components", "ui", "neobrutalism", "accessible"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "check": "bun run test -- --run && bun run typecheck && bun run build",
    "dev:playground": "vite --config playground/vite.config.ts",
    "prepack": "bun run check",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vee-validate": "^4.15.1",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "reka-ui": "^2.10.4"
  }
}
