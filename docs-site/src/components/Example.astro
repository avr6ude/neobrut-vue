---
import '@neobrut-vue/core/style.css'
import { Code } from 'astro:components'
import DocsExample from './DocsExample.vue'

interface Props {
  source: string
  title: string
}

const { source, title } = Astro.props
---

<DocsExample client:load source={source} title={title}>
  <div slot="preview"><slot /></div>
  <div slot="code"><Code code={source.trim()} lang="vue" embeddedLangs={['typescript', 'css']} theme="github-dark" /></div>
</DocsExample>
